{
  "$schema": "https://raw.githubusercontent.com/keenmate/schemas/main/component-variables.schema.json",
  "component": "@keenmate/web-commandpalette",
  "prefix": "cp",
  "note": "The palette ships its own plain CSS (src/css/*.css, multiselect-style layers). Every --cp-* knob is declared on :host and reads the shared --base-* contract (@keenmate/base-css-variables 2.0) with an inline fallback, so a :root theme reaches it; set --cp-* on the element itself.",
  "baseVariables": [
    {
      "name": "base-border-color",
      "required": false,
      "usage": "Dividers (search row, sections, footer, pagination) and keycap borders"
    },
    {
      "name": "base-border-radius-md",
      "required": false,
      "usage": "Container corner radius (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-border-radius-sm",
      "required": false,
      "usage": "Row / keycap / badge corner radius (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-border-width",
      "required": false,
      "usage": "Stroke width of every border"
    },
    {
      "name": "base-danger-color",
      "required": false,
      "usage": "danger badge background"
    },
    {
      "name": "base-duration-fast",
      "required": false,
      "usage": "Hover / focus transitions"
    },
    {
      "name": "base-duration-medium",
      "required": false,
      "usage": "Confirmation collapse"
    },
    {
      "name": "base-duration-normal",
      "required": false,
      "usage": "Open animation"
    },
    {
      "name": "base-ease-out",
      "required": false,
      "usage": "Easing of the border / color transitions"
    },
    {
      "name": "base-ease-standard",
      "required": false,
      "usage": "Easing of the animations"
    },
    {
      "name": "base-font-family",
      "required": false,
      "usage": "Text font of the whole palette (default: inherited from the page)"
    },
    {
      "name": "base-font-size-2xs",
      "required": false,
      "usage": "Section headings (unitless multiplier of --base-rem; default 1)"
    },
    {
      "name": "base-font-size-base",
      "required": false,
      "usage": "The search input and its placeholder (default 1.6)"
    },
    {
      "name": "base-font-size-lg",
      "required": false,
      "usage": "Icon-font glyphs (<i>) in the row icon box (default 1.8)"
    },
    {
      "name": "base-font-size-sm",
      "required": false,
      "usage": "Row titles, empty/loader text (default 1.4)"
    },
    {
      "name": "base-font-size-xs",
      "required": false,
      "usage": "Meta text, keycaps, footer hints, context pill (default 1.2)"
    },
    {
      "name": "base-font-weight-medium",
      "required": false,
      "usage": "Row titles, scope pill"
    },
    {
      "name": "base-font-weight-semibold",
      "required": false,
      "usage": "Headings, query highlight, keycaps"
    },
    {
      "name": "base-highlighted-bg",
      "required": false,
      "usage": "Active row (the keyboard cursor) background — the shared item-state tint"
    },
    {
      "name": "base-highlighted-text-color",
      "required": false,
      "usage": "Active row text"
    },
    {
      "name": "base-hover-bg",
      "required": false,
      "usage": "Row hover (the neutral hover overlay)"
    },
    {
      "name": "base-icon-check",
      "required": false,
      "usage": "✓ glyph (chained by --cp-icon-check)"
    },
    {
      "name": "base-icon-close",
      "required": false,
      "usage": "✕ glyph (chained by --cp-icon-close)"
    },
    {
      "name": "base-info-color",
      "required": false,
      "usage": "info badge background"
    },
    {
      "name": "base-input-bg",
      "required": false,
      "usage": "Search input and close-button background"
    },
    {
      "name": "base-input-border",
      "required": false,
      "usage": "Search input / close-button border"
    },
    {
      "name": "base-input-border-color",
      "required": false,
      "usage": "Search input / close-button outline (fallback chain)"
    },
    {
      "name": "base-input-border-focus",
      "required": false,
      "usage": "Search input focus border"
    },
    {
      "name": "base-input-border-hover",
      "required": false,
      "usage": "Close-button hover border"
    },
    {
      "name": "base-input-box-shadow-focus",
      "required": false,
      "usage": "Search input focus halo"
    },
    {
      "name": "base-input-placeholder-color",
      "required": false,
      "usage": "Search input placeholder"
    },
    {
      "name": "base-input-shadow-color-focus",
      "required": false,
      "usage": "Focus halo tone (fallback chain)"
    },
    {
      "name": "base-input-size-lg-height",
      "required": false,
      "usage": "Search input and close-button height (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-input-text-color",
      "required": false,
      "usage": "Search input text"
    },
    {
      "name": "base-main-bg",
      "required": false,
      "usage": "Dialog surface (also the input fallback)"
    },
    {
      "name": "base-on-danger-text-color",
      "required": false,
      "usage": "Text on the danger badge"
    },
    {
      "name": "base-on-info-text-color",
      "required": false,
      "usage": "Text on the info badge"
    },
    {
      "name": "base-on-primary-text-color",
      "required": false,
      "usage": "Text on the primary badge"
    },
    {
      "name": "base-on-secondary-text-color",
      "required": false,
      "usage": "Plain / secondary badge text"
    },
    {
      "name": "base-on-success-text-color",
      "required": false,
      "usage": "Text on the success badge"
    },
    {
      "name": "base-on-warning-text-color",
      "required": false,
      "usage": "Text on the warning badge"
    },
    {
      "name": "base-overlay-bg",
      "required": false,
      "usage": "Backdrop scrim"
    },
    {
      "name": "base-primary-bg-subtle",
      "required": false,
      "usage": "Primary tint: scope pill, row icon box (and the active row when --base-highlighted-bg is absent)"
    },
    {
      "name": "base-primary-bg-subtle-hover",
      "required": false,
      "usage": "Query-match highlight background"
    },
    {
      "name": "base-primary-color",
      "required": true,
      "usage": "Accent: focus border, scope pill, row icons, query highlight, primary badge, spinner, star, ✓ and countdown"
    },
    {
      "name": "base-rem",
      "required": false,
      "usage": "Size unit for every rem-based dimension (default 10px; pure-admin hosts set 1rem)"
    },
    {
      "name": "base-secondary-color",
      "required": false,
      "usage": "Plain / secondary badge background"
    },
    {
      "name": "base-shadow-color",
      "required": false,
      "usage": "Dialog shadow tone"
    },
    {
      "name": "base-space-2xl",
      "required": false,
      "usage": "Spacing step: empty / loading padding (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-space-base",
      "required": false,
      "usage": "Spacing step: footer gap, narrow-window offset (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-space-sm",
      "required": false,
      "usage": "Spacing step: the main padding (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-space-xl",
      "required": false,
      "usage": "Spacing step: narrow-window side margin (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-space-xs",
      "required": false,
      "usage": "Spacing step (unitless multiplier of the rem unit)"
    },
    {
      "name": "base-subtle-bg",
      "required": false,
      "usage": "Keycap background"
    },
    {
      "name": "base-success-color",
      "required": false,
      "usage": "success badge background"
    },
    {
      "name": "base-text-color-1",
      "required": false,
      "usage": "Primary text (titles, input, keycaps)"
    },
    {
      "name": "base-text-color-2",
      "required": false,
      "usage": "Secondary text (meta lines, hints, headings)"
    },
    {
      "name": "base-text-color-3",
      "required": false,
      "usage": "Favorite star (off)"
    },
    {
      "name": "base-warning-color",
      "required": false,
      "usage": "warning badge background"
    }
  ],
  "componentVariables": [
